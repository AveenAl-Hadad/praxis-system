<Window x:Class="Praxis.Client.Views.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Passwort ändern"
        Width="420"
        Height="280"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Passwort ändern"
                   FontSize="22"
                   FontWeight="Bold"
                   Margin="0,0,0,16"/>

        <PasswordBox x:Name="OldPasswordBox"
                     Grid.Row="1"
                     Height="34"
                     Margin="0,0,0,10"
                     ToolTip="Altes Passwort"/>

        <PasswordBox x:Name="NewPasswordBox"
                     Grid.Row="2"
                     Height="34"
                     Margin="0,0,0,10"
                     ToolTip="Neues Passwort"/>

        <PasswordBox x:Name="ConfirmPasswordBox"
                     Grid.Row="3"
                     Height="34"
                     VerticalAlignment="Top"
                     ToolTip="Neues Passwort wiederholen"/>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Abbrechen"
                    Width="100"
                    Height="34"
                    Margin="0,0,8,0"
                    Click="Cancel_Click"/>

            <Button Content="Speichern"
                    Width="100"
                    Height="34"
                    Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>