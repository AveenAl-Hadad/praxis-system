<UserControl x:Class="Praxis.Client.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Einstellungen"
                       FontSize="28"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

            <TextBlock Text="Benutzer"
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="0,0,0,8"/>

            <Border Background="#EEF3F6"
                    BorderBrush="#CCD6DD"
                    BorderThickness="1"
                    Padding="12"
                    Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock x:Name="CurrentUserText"
                               FontSize="14"
                               Margin="0,0,0,8"/>

                    <Button Content="Passwort ändern"
                            Width="180"
                            Height="34"
                            HorizontalAlignment="Left"
                            Click="ChangePassword_Click"/>
                </StackPanel>
            </Border>

            <TextBlock Text="Darstellung"
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="0,0,0,8"/>

            <Border Background="#EEF3F6"
                    BorderBrush="#CCD6DD"
                    BorderThickness="1"
                    Padding="12"
                    Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Helles Design"
                            Width="140"
                            Height="34"
                            Margin="0,0,8,0"
                            Click="LightTheme_Click"/>

                    <Button Content="Dunkles Design"
                            Width="140"
                            Height="34"
                            Click="DarkTheme_Click"/>
                </StackPanel>
            </Border>

            <StackPanel x:Name="AdminPanel">
                <TextBlock Text="Administration"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="0,0,0,8"/>

                <Border Background="#FFF3E0"
                        BorderBrush="#E0B56A"
                        BorderThickness="1"
                        Padding="12"
                        Margin="0,0,0,16">
                    <WrapPanel>
                        <Button Content="Benutzerverwaltung"
                                Width="170"
                                Height="34"
                                Margin="0,0,8,8"
                                Click="UserManagement_Click"/>

                        <Button Content="Backup erstellen"
                                Width="150"
                                Height="34"
                                Margin="0,0,8,8"
                                Click="CreateBackup_Click"/>

                        <Button Content="Backup wiederherstellen"
                                Width="190"
                                Height="34"
                                Margin="0,0,8,8"
                                Click="RestoreBackup_Click"/>
                    </WrapPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>