<UserControl x:Class="Praxis.Client.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Einstellungen"
                       FontSize="28"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

            <TextBlock Text="Benutzer"
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="0,0,0,8"/>

            <Border Background="#EEF3F6"
                    BorderBrush="#CCD6DD"
                    BorderThickness="1"
                    Padding="8"
                    Margin="0,0,0,5
">
                <StackPanel>
                    <TextBlock x:Name="CurrentUserText"
                               FontSize="14"
                               Margin="0,0,0,8"/>

                    <Button Content="Passwort ändern"
                            Width="180"
                            Height="34"
                            HorizontalAlignment="Left"
                            Click="ChangePassword_Click"/>
                </StackPanel>
            </Border>

            <TextBlock Text="Darstellung"
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="0,0,0,8"/>

            <Border Background="#EEF3F6"
                    BorderBrush="#CCD6DD"
                    BorderThickness="1"
                    Padding="12"
                    Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Helles Design"
                            Width="140"
                            Height="34"
                            Margin="0,0,8,0"
                            Click="LightTheme_Click"/>

                    <Button Content="Dunkles Design"
                            Width="140"
                            Height="34"
                            Click="DarkTheme_Click"/>
                </StackPanel>
            </Border>

            <StackPanel x:Name="AdminPanel">
                <TextBlock Text="Administration"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="0,0,0,8"/>

                <Border Background="#FFF3E0"
                        BorderBrush="#E0B56A"
                        BorderThickness="1"
                        Padding="12"
                        Margin="0,0,0,16">
                    <WrapPanel>
                        <Button Content="Benutzerverwaltung"
                                Width="170"
                                Height="34"
                                Margin="0,0,8,8"
                                Click="UserManagement_Click"/>

                        <Button Content="Backup erstellen"
                                Width="150"
                                Height="34"
                                Margin="0,0,8,8"
                                Click="CreateBackup_Click"/>

                        <Button Content="Backup wiederherstellen"
                                Width="190"
                                Height="34"
                                Margin="0,0,8,8"
                                Click="RestoreBackup_Click"/>
                    </WrapPanel>
                </Border>
                
                <TextBlock Text="Praxisdaten"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="0,0,0,8"/>

                <Border x:Name="PracticeSettingsPanel"
                        Background="#EEF3F6"
                        BorderBrush="#CCD6DD"
                        BorderThickness="1"
                        Padding="12"
                        Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Praxisname:" Grid.Row="0"/>
                        <TextBox x:Name="PracticeNameBox" Grid.Row="0" Grid.Column="1"/>

                        <TextBlock Text="Arzt:" Grid.Row="2"/>
                        <TextBox x:Name="DoctorNameBox" Grid.Row="2" Grid.Column="1"/>

                        <TextBlock Text="Straße:" Grid.Row="4"/>
                        <TextBox x:Name="StreetBox" Grid.Row="4" Grid.Column="1"/>

                        <TextBlock Text="PLZ / Ort:" Grid.Row="6"/>
                        <TextBox x:Name="ZipCityBox" Grid.Row="6" Grid.Column="1"/>

                        <TextBlock Text="Telefon:" Grid.Row="8"/>
                        <TextBox x:Name="PhoneBox" Grid.Row="8" Grid.Column="1"/>

                        <TextBlock Text="E-Mail:" Grid.Row="10"/>
                        <TextBox x:Name="EmailBox" Grid.Row="10" Grid.Column="1"/>

                        <Button Content="Praxisdaten speichern"
                                Grid.Row="12"
                                Grid.Column="1"
                                Width="180"
                                Height="34"
                                HorizontalAlignment="Left"
                                Click="SavePracticeSettings_Click"/>
                    </Grid>
                </Border>
            </StackPanel>
        </StackPanel>
    </Grid>
    </ScrollViewer>
</UserControl>