<UserControl x:Class="Praxis.Client.Views.Pages.MessagesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Nachrichten"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,12"/>

        <TabControl x:Name="MessagesTabControl" Grid.Row="1">

            <TabItem Header="Posteingang">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="140"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="InboxGrid"
                              AutoGenerateColumns="False"
                              SelectionChanged="InboxGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Von" Binding="{Binding Sender}" Width="120"/>
                            <DataGridTextColumn Header="Betreff" Binding="{Binding Subject}" Width="*"/>
                            <DataGridTextColumn Header="Priorität" Binding="{Binding Priority}" Width="100"/>
                            <DataGridCheckBoxColumn Header="Gelesen" Binding="{Binding IsRead}" Width="80"/>
                            <DataGridTextColumn Header="Datum" Binding="{Binding CreatedAt, StringFormat=dd.MM.yyyy HH:mm}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="InboxBodyText"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"/>

                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <Button Content="Als gelesen"
                                    Width="120"
                                    Height="30"
                                    Margin="0,0,0,8"
                                    Click="MarkRead_Click"/>

                            <Button Content="Löschen"
                                    Width="120"
                                    Height="30"
                                    Click="DeleteMessage_Click"/>
                        </StackPanel>
                    </Grid>

                </Grid>
            </TabItem>

            <TabItem Header="Gesendet">
                <DataGrid x:Name="SentGrid" AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="An" Binding="{Binding Recipient}" Width="120"/>
                        <DataGridTextColumn Header="Betreff" Binding="{Binding Subject}" Width="*"/>
                        <DataGridTextColumn Header="Priorität" Binding="{Binding Priority}" Width="100"/>
                        <DataGridTextColumn Header="Datum" Binding="{Binding CreatedAt, StringFormat=dd.MM.yyyy HH:mm}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Neue Nachricht">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Empfänger:" Width="90" VerticalAlignment="Center"/>
                        <ComboBox x:Name="RecipientCombo" Width="220">
                            <ComboBoxItem Content="Arzt"/>
                            <ComboBoxItem Content="MFA"/>
                            <ComboBoxItem Content="Empfang"/>
                            <ComboBoxItem Content="Labor"/>
                            <ComboBoxItem Content="Abrechnung"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Priorität:" Width="90" VerticalAlignment="Center"/>
                        <ComboBox x:Name="PriorityCombo" Width="220">
                            <ComboBoxItem Content="Normal"/>
                            <ComboBoxItem Content="Wichtig"/>
                            <ComboBoxItem Content="Dringend"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Patient:" Width="90" VerticalAlignment="Center"/>

                        <TextBox x:Name="PatientSearchText"
                                 Width="180"
                                 Margin="0,0,6,0"/>

                        <Button Content="Suchen"
                                Width="80"
                                Margin="0,0,6,0"
                                Click="SearchPatient_Click"/>

                        <ComboBox x:Name="PatientCombo"
                                  Width="260"
                                  DisplayMemberPath="FullName"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Betreff:" Width="90" VerticalAlignment="Center"/>
                        <TextBox x:Name="SubjectText" Width="420"/>
                    </StackPanel>

                    <TextBox x:Name="BodyText"
                             Grid.Row="4"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"/>

                    <Button Grid.Row="5"
                            Content="Nachricht senden"
                            Width="160"
                            Height="34"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Left"
                            Click="Send_Click"/>
                </Grid>
            </TabItem>
            
            <TabItem Header="Externe Nachrichten">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Externe Nachrichten"
                               FontSize="16"
                               FontWeight="Bold"
                               Margin="0,0,0,8"/>

                    <DataGrid Grid.Row="1"
                              x:Name="ExternalMessagesGrid"
                              AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Absender" Binding="{Binding Sender}" Width="160"/>
                            <DataGridTextColumn Header="Betreff" Binding="{Binding Subject}" Width="*"/>
                            <DataGridTextColumn Header="Datum" Binding="{Binding CreatedAt, StringFormat=dd.MM.yyyy HH:mm}" Width="160"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Notizen">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="170"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Praxis-Notizen"
                               FontSize="16"
                               FontWeight="Bold"
                               Margin="0,0,0,8"/>

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBox x:Name="NoteTitleText"
                                 Height="28"
                                 Margin="0,0,0,8"
                                 Text=""/>

                        <TextBox x:Name="NoteText"
                                 Grid.Row="1"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"/>
                    </Grid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,8">
                        <Button Content="Notiz speichern"
                                Width="140"
                                Height="32"
                                Margin="0,0,8,0"
                                Click="SaveNote_Click"/>

                        <Button Content="Notiz löschen"
                                Width="120"
                                Height="32"
                                Click="DeleteNote_Click"/>
                    </StackPanel>

                    <DataGrid x:Name="NotesGrid"
                              Grid.Row="3"
                              AutoGenerateColumns="False"
                              SelectionChanged="NotesGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Titel" Binding="{Binding Title}" Width="*"/>
                            <DataGridTextColumn Header="Erstellt von" Binding="{Binding CreatedBy}" Width="120"/>
                            <DataGridTextColumn Header="Datum" Binding="{Binding CreatedAt, StringFormat=dd.MM.yyyy HH:mm}" Width="160"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Arztbriefe">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Arztbrief erstellen"
                               FontSize="16"
                               FontWeight="Bold"
                               Margin="0,0,0,8"/>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Betreff:" Width="90" VerticalAlignment="Center"/>
                        <TextBox x:Name="DoctorLetterSubjectText" Width="420"/>
                    </StackPanel>

                    <TextBox x:Name="DoctorLetterBodyText"
                             Grid.Row="2"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"/>

                    <Button Grid.Row="3"
                            Content="Arztbrief speichern"
                            Width="160"
                            Height="32"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Left"
                            Click="SaveDoctorLetter_Click"/>
                </Grid>
            </TabItem>

        </TabControl>
        
    </Grid>
</UserControl>