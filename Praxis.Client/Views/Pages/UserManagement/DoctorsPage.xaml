<UserControl x:Class="Praxis.Client.Views.Pages.UserManagement.DoctorsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Ärzteverwaltung"
                   Style="{StaticResource SectionTitleStyle}"/>

        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="42"/>
                    <RowDefinition Height="42"/>
                    <RowDefinition Height="42"/>
                    <RowDefinition Height="42"/>
                    <RowDefinition Height="42"/>
                    <RowDefinition Height="52"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Titel:" VerticalAlignment="Center"/>
                <TextBox x:Name="TitleTextBox" Grid.Column="1" Margin="0,4,0,4"/>

                <TextBlock Grid.Row="1" Text="Vorname:" VerticalAlignment="Center"/>
                <TextBox x:Name="FirstNameTextBox" Grid.Row="1" Grid.Column="1" Margin="0,4,0,4"/>

                <TextBlock Grid.Row="2" Text="Nachname:" VerticalAlignment="Center"/>
                <TextBox x:Name="LastNameTextBox" Grid.Row="2" Grid.Column="1" Margin="0,4,0,4"/>

                <TextBlock Grid.Row="3" Text="Fachrichtung:" VerticalAlignment="Center"/>
                <TextBox x:Name="SpecialtyTextBox" Grid.Row="3" Grid.Column="1" Margin="0,4,0,4"/>

                <TextBlock Grid.Row="4" Text="Standardraum:" VerticalAlignment="Center"/>
                <ComboBox x:Name="DefaultRoomComboBox"
                          Grid.Row="4"
                          Grid.Column="1"
                          Margin="0,4,0,4"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Name"/>
                
               <CheckBox x:Name="IsActiveCheckBox"
                          Grid.Row="0"
                          Grid.Column="4"
                          Content="Aktiv"
                          IsChecked="True"
                          VerticalAlignment="Center"/>

                <CheckBox x:Name="AllowOnlineBookingCheckBox"
                          Grid.Row="1"
                          Grid.Column="4"
                          Content="Online-Buchung erlaubt"
                          IsChecked="True"
                          VerticalAlignment="Center"/>

                <StackPanel Grid.Row="2"
                            Grid.RowSpan="3"
                            Grid.Column="4"
                            Margin="0,4,0,4">

                    <TextBlock Text="Erlaubte Terminarten:"
                               FontWeight="Bold"
                               Margin="0,0,0,6"/>

                    <ItemsControl x:Name="AppointmentTypesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Name}"
                                          IsChecked="{Binding IsAssigned, Mode=TwoWay}"
                                          Margin="0,2,0,2"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>


                <StackPanel Grid.Row="5"
                            Grid.Column="4"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left">
                    <Button Content="Neu"
                            Width="50"
                            Margin="0,0,10,0"
                            Click="NeuButton_Click"/>
                    <Button Content="Speichern"
                            Width="100"
                            Margin="0,0,10,0"
                            Style="{StaticResource SuccessButtonStyle}"
                            Click="SpeichernButton_Click"/>
                    <Button Content="Löschen"
                            Width="100"
                            Background="#d9534f"
                            Foreground="White"
                            Click="LoeschenButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource CardBorderStyle}">
            <DataGrid x:Name="DoctorsGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      SelectionChanged="DoctorsGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70"/>
                    <DataGridTextColumn Header="Titel" Binding="{Binding Title}" Width="90"/>
                    <DataGridTextColumn Header="Vorname" Binding="{Binding FirstName}" Width="140"/>
                    <DataGridTextColumn Header="Nachname" Binding="{Binding LastName}" Width="140"/>
                    <DataGridTextColumn Header="Fachrichtung" Binding="{Binding Specialty}" Width="160"/>
                    <DataGridTextColumn Header="Standardraum" Binding="{Binding DefaultRoomName}" Width="140"/>
                    <DataGridCheckBoxColumn Header="Aktiv" Binding="{Binding IsActive}" Width="80"/>
                    <DataGridCheckBoxColumn Header="Online" Binding="{Binding AllowOnlineBooking}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>