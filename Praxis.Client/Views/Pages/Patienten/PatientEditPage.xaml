<UserControl x:Class="Praxis.Client.Views.Pages.Patienten.PatientEditPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Patient bearbeiten"
                       Style="{StaticResource SectionTitleStyle}"/>

            <!-- Edit Form -->
            <Border Grid.Row="2"
                    Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="320"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="40"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Patient auswählen:" VerticalAlignment="Center"/>
                    <ComboBox x:Name="PatientComboBox"
                              Grid.Column="1"
                              Margin="0,4,0,4"
                              DisplayMemberPath="FullName"
                              SelectionChanged="PatientComboBox_SelectionChanged"/>

                    <TextBlock Grid.Row="1" Text="Vorname:" VerticalAlignment="Center"/>
                    <TextBox x:Name="VornameTextBox"
                             Grid.Row="1"
                             Grid.Column="1"
                             Margin="0,4,0,4"/>

                    <TextBlock Grid.Row="2" Text="Nachname:" VerticalAlignment="Center"/>
                    <TextBox x:Name="NachnameTextBox"
                             Grid.Row="2"
                             Grid.Column="1"
                             Margin="0,4,0,4"/>

                    <TextBlock Grid.Row="3" Text="Geburtsdatum:" VerticalAlignment="Center"/>
                    <DatePicker x:Name="GeburtsdatumPicker"
                                Grid.Row="3"
                                Grid.Column="1"
                                Margin="0,4,0,4"/>

                    <TextBlock Grid.Row="4" Text="Telefon:" VerticalAlignment="Center"/>
                    <TextBox x:Name="TelefonTextBox"
                             Grid.Row="4"
                             Grid.Column="1"
                             Margin="0,4,0,4"/>

                    <TextBlock Grid.Row="5" Text="E-Mail:" VerticalAlignment="Center"/>
                    <TextBox x:Name="EmailTextBox"
                             Grid.Row="5"
                             Grid.Column="1"
                             Margin="0,4,0,4"/>

                    <TextBlock Grid.Row="6" Text="Adresse:" VerticalAlignment="Center"/>
                    <TextBox x:Name="AdresseTextBox"
                             Grid.Row="6"
                             Grid.Column="1"
                             Margin="0,4,0,4"/>

                    <TextBlock Grid.Row="7" Text="PLZ:" VerticalAlignment="Center"/>
                    <TextBox x:Name="PLZTextBox"
                             Grid.Row="7"
                             Grid.Column="1"
                             Margin="0,4,0,4"/>

                    <TextBlock Grid.Column="3" Text="Ort:" VerticalAlignment="Center"/>
                    <TextBox x:Name="OrtTextBox"
                             Grid.Column="4"
                             Margin="0,4,0,4"/>

                    <TextBlock Grid.Row="1" Grid.Column="3" Text="Versicherung:" VerticalAlignment="Center"/>
                    <ComboBox x:Name="VersicherungComboBox"
                              Grid.Row="1"
                              Grid.Column="4"
                              Margin="0,4,0,4">
                        <ComboBoxItem Content="Gesetzlich"/>
                        <ComboBoxItem Content="Privat"/>
                    </ComboBox>

                    <TextBlock Grid.Row="2" Grid.Column="3" Text="Geschlecht:" VerticalAlignment="Center"/>
                    <ComboBox x:Name="GeschlechtComboBox"
                              Grid.Row="2"
                              Grid.Column="4"
                              Margin="0,4,0,4">
                        <ComboBoxItem Content="Weiblich"/>
                        <ComboBoxItem Content="Männlich"/>
                        <ComboBoxItem Content="Divers"/>
                    </ComboBox>

                    <TextBlock Grid.Row="3" Grid.Column="3" Text="Versichertennr.:" VerticalAlignment="Center"/>
                    <TextBox x:Name="VersichertennummerTextBox"
                             Grid.Row="3"
                             Grid.Column="4"
                             Margin="0,4,0,4"/>

                    <TextBlock Grid.Row="4" Grid.Column="3" Text="Aktiv:" VerticalAlignment="Center"/>
                    <CheckBox x:Name="IsActiveCheckBox"
                              Grid.Row="4"
                              Grid.Column="4"
                              VerticalAlignment="Center"/>
                </Grid>
            </Border>
            
            <!--Buttons für Edit -->
            <StackPanel Grid.Row="4"
                        Orientation="Horizontal"
                        HorizontalAlignment="Left">
                <Button Content="Speichern"
                        Width="130"
                        Style="{StaticResource SuccessButtonStyle}"
                        Click="SaveButton_Click"/>

                <Button Content="Zurücksetzen"
                        Width="130"
                        Margin="10,0,0,0"
                        Style="{StaticResource WarningButtonStyle}"
                        Click="ResetButton_Click"/>

                <Button Content="Zurück"
                        Width="130"
                        Margin="10,0,0,0"
                        Click="BackButton_Click"/>
            </StackPanel>
            
            <!-- Diagnose -->
            <Border Grid.Row="6" Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="Diagnosen"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBox x:Name="DiagnosisSearchBox"
                                     Height="32"
                                     Padding="8,0,8,0"
                                     VerticalContentAlignment="Center"
                                     TextChanged="DiagnosisSearchBox_TextChanged"
                                     KeyDown="DiagnosisSearchBox_KeyDown"/>

                            <ListBox x:Name="DiagnosisSuggestionList"
                                     MaxHeight="160"
                                     Visibility="Collapsed"
                                     DisplayMemberPath="DisplayText"
                                     MouseDoubleClick="DiagnosisSuggestionList_MouseDoubleClick"
                                     KeyDown="DiagnosisSuggestionList_KeyDown"/>
                        </StackPanel>

                        <TextBox x:Name="DiagnosisNotesBox"
                                 Grid.Column="1"
                                 Height="32"
                                 Margin="10,0,10,0"
                                 VerticalContentAlignment="Center"
                                 ToolTip="Notiz zur Diagnose"/>

                        <Button Content="Hinzufügen"
                                Grid.Column="2"
                                Height="32"
                                Click="AddDiagnosis_Click"/>
                    </Grid>

                    <DataGrid x:Name="DiagnosesGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Height="180"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Datum"
                                    Binding="{Binding DiagnosedAt, StringFormat=dd.MM.yyyy}"
                                    Width="100"/>
                            <DataGridTextColumn Header="ICD"
                                    Binding="{Binding CatalogItem.Code}"
                                    Width="100"/>
                            <DataGridTemplateColumn Header="Diagnose" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding CatalogItem.Name}"
                                                        FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding CatalogItem.Description}"
                                                       FontSize="11"
                                                       Foreground="Gray"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Notiz"
                                    Binding="{Binding Notes}"
                                    Width="220"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button x:Name="DeleteDiagnosisButton"
                            Content="Ausgewählte Diagnose löschen"
                            Width="220"
                            Height="32"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Left"
                            Click="DeleteDiagnosis_Click"/>
                </StackPanel>
            </Border>
            
            <!-- Medikamente/Rezept -->
            <Border Grid.Row="8" Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="Medikamente / Verordnung"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBox x:Name="MedicationSearchBox"
                                     Height="32"
                                     Padding="8,0,8,0"
                                     VerticalContentAlignment="Center"
                                     TextChanged="MedicationSearchBox_TextChanged"
                                     KeyDown="MedicationSearchBox_KeyDown"/>

                            <ListBox x:Name="MedicationSuggestionList"
                                     MaxHeight="160"
                                     Visibility="Collapsed"
                                     DisplayMemberPath="DisplayText"
                                     MouseDoubleClick="MedicationSuggestionList_MouseDoubleClick"
                                     KeyDown="MedicationSuggestionList_KeyDown"/>
                        </StackPanel>

                        <TextBox x:Name="MedicationDosageBox"
                                 Grid.Column="1"
                                 Height="32"
                                 Margin="10,0,10,0"
                                 VerticalContentAlignment="Center"
                                 ToolTip="Dosierung z.B. 1-0-1"/>

                        <TextBox x:Name="MedicationNotesBox"
                                 Grid.Column="2"
                                 Height="32"
                                 Margin="0,0,10,0"
                                 VerticalContentAlignment="Center"
                                 ToolTip="Notiz"/>

                        <Button Content="Hinzufügen"
                                Grid.Column="3"
                                Height="32"
                                Click="AddMedication_Click"/>
                    </Grid>

                    <DataGrid x:Name="MedicationsGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Height="180"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Datum"
                                    Binding="{Binding PrescribedAt, StringFormat=dd.MM.yyyy}"
                                    Width="100"/>

                            <DataGridTextColumn Header="Code"
                                    Binding="{Binding CatalogItem.Code}"
                                    Width="100"/>

                            <DataGridTextColumn Header="Medikament"
                                    Binding="{Binding CatalogItem.Name}"
                                    Width="*"/>

                            <DataGridTextColumn Header="Dosierung"
                                    Binding="{Binding Dosage}"
                                    Width="120"/>

                            <DataGridTextColumn Header="Notiz"
                                    Binding="{Binding Notes}"
                                    Width="220"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button x:Name="DeleteMedicationButton"
                            Content="Ausgewählte Verordnung löschen"
                            Width="240"
                            Height="32"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Left"
                            Click="DeleteMedication_Click"/>
                </StackPanel>
            </Border>

            
        </Grid>
    </ScrollViewer>
</UserControl>