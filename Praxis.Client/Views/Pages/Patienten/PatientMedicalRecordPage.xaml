<UserControl x:Class="Praxis.Client.Views.Pages.Patienten.PatientMedicalRecordPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Karteikarte"
                   Style="{StaticResource SectionTitleStyle}"/>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="520"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Links: Karteikarten-Einträge -->
            <Border Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Einträge"
                               FontWeight="SemiBold"/>
                    
                    <ComboBox x:Name="FilterTypeComboBox"
                              Grid.Row="2"
                              Height="30"
                              SelectionChanged="FilterTypeComboBox_SelectionChanged"/>

                        <DataGrid x:Name="EntriesGrid"
                                  Grid.Row="4"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionChanged="EntriesGrid_SelectionChanged">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Datum"
                                                Binding="{Binding CreatedAt, StringFormat=dd.MM.yyyy HH:mm}"
                                                Width="100"/>

                            <DataGridTextColumn Header="Typ"
                                                Binding="{Binding EntryType}"
                                                Width="90"/>

                            <DataGridTextColumn Header="Titel"
                                                Binding="{Binding Title}"
                                                Width="90"/>
                            
                            <DataGridTextColumn Header="Rechnung"
                                                Binding="{Binding Invoice.InvoiceNumber}"
                                                Width="120"/>

                            <DataGridTextColumn Header="Abgerechnet"
                                                Binding="{Binding InvoiceId}"
                                                Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Rechts: Formular -->
            <Border Grid.Column="2"
                    Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="PatientHeaderTextBlock"
                               Text="Keine Patientin / kein Patient ausgewählt"
                               FontSize="18"
                               FontWeight="SemiBold"/>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="40"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Typ:"
                                   VerticalAlignment="Center"/>

                        <ComboBox x:Name="EntryTypeComboBox"
                                  Grid.Column="1"
                                  Margin="0,4"/>

                        <TextBlock Grid.Column="3"
                                   Text="Titel:"
                                   VerticalAlignment="Center"/>

                        <TextBox x:Name="TitleTextBox"
                                 Grid.Column="4"
                                 Margin="0,4"/>

                        <TextBlock Grid.Row="1"
                                   Text="ICD-Code:"
                                   VerticalAlignment="Center"/>

                        <TextBox x:Name="IcdCodeTextBox"
                                 Grid.Row="1"
                                 Grid.Column="1"
                                 Margin="0,4"/>

                        <TextBlock Grid.Row="1"
                                   Grid.Column="3"
                                   Text="ICD-Text:"
                                   VerticalAlignment="Center"/>

                        <TextBox x:Name="IcdTextTextBox"
                                 Grid.Row="1"
                                 Grid.Column="4"
                                 Margin="0,4"/>

                        <TextBlock Grid.Row="2"
                                   Text="Erstellt von:"
                                   VerticalAlignment="Center"/>

                        <TextBox x:Name="CreatedByTextBox"
                                 Grid.Row="2"
                                 Grid.Column="1"
                                 Margin="0,4"/>
                    </Grid>

                    <TextBox x:Name="TextTextBox"
                             Grid.Row="4"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             MinHeight="300"
                             FontSize="15"
                             Padding="8"/>

                    <StackPanel Grid.Row="6"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">

                        <Button x:Name="NewButton"
                                Content="Neu"
                                Width="100"
                                Margin="0,0,8,0"
                                Click="NewButton_Click"/>

                        <Button x:Name="SaveButton"
                                Content="Speichern"
                                Width="120"
                                Margin="0,0,8,0"
                                Click="SaveButton_Click"/>

                        <Button  x:Name="OpenInvoiceButton"
                                Content="Rechnung öffnen"
                                Width="140"
                                Margin="0,0,8,0"
                                Click="OpenInvoiceButton_Click"/>

                       <Button x:Name="OpenLaborRecordButton"
                                Content="Laborbericht öffnen"
                                Width="150"
                                Margin="0,0,8,0"
                                Click="OpenLaborRecordButton_Click"/>

                      <Button x:Name="DeleteButton"
                                Content="Löschen"
                                Width="100"
                                Click="DeleteButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
    </ScrollViewer>
</UserControl>