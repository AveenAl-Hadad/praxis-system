<UserControl x:Class="Praxis.Client.Views.Pages.ReportsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Titel -->
        <TextBlock Text="Auswertungen &amp; Statistik"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,12"/>

        <!-- Zeitraum -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Von:" VerticalAlignment="Center"/>
            <DatePicker x:Name="FromDatePicker" Width="140" Margin="6,0,12,0"/>

            <TextBlock Text="Bis:" VerticalAlignment="Center"/>
            <DatePicker x:Name="ToDatePicker" Width="140" Margin="6,0,12,0"/>

            <Button Content="Aktualisieren" Width="130" Click="Refresh_Click"/>
            <Button Content="PDF Export" Width="110" Margin="8,0,0,0" Click="ExportPdf_Click"/>
            <Button Content="Excel Export" Width="110" Margin="8,0,0,0" Click="ExportExcel_Click"/>
            
        </StackPanel>

        <!-- Kennzahlen -->
        <UniformGrid Grid.Row="2" Columns="5" Margin="0,0,0,12">

            <Border Background="#F4F6F8" Margin="4" Padding="10">
                <StackPanel>
                    <TextBlock Text="Patienten"/>
                    <TextBlock x:Name="PatientsText" FontSize="20" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Background="#F4F6F8" Margin="4" Padding="10">
                <StackPanel>
                    <TextBlock Text="Termine"/>
                    <TextBlock x:Name="AppointmentsText" FontSize="20" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Background="#F4F6F8" Margin="4" Padding="10">
                <StackPanel>
                    <TextBlock Text="Diagnosen"/>
                    <TextBlock x:Name="DiagnosesText" FontSize="20" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Background="#F4F6F8" Margin="4" Padding="10">
                <StackPanel>
                    <TextBlock Text="Rechnungen"/>
                    <TextBlock x:Name="InvoicesText" FontSize="20" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Background="#F4F6F8" Margin="4" Padding="10">
                <StackPanel>
                    <TextBlock Text="Umsatz"/>
                    <TextBlock x:Name="RevenueText" FontSize="20" FontWeight="Bold"/>
                </StackPanel>
            </Border>

        </UniformGrid>

        <!-- Tabellen -->
        <TabControl  x:Name="ReportsTabControl"  Grid.Row="3">

            <TabItem Header="Diagnosen">
                <DataGrid x:Name="DiagnosisGrid" AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Diagnose" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Anzahl" Binding="{Binding Count}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Rechnungen">
                <DataGrid x:Name="InvoiceGrid" AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Datum" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Anzahl" Binding="{Binding Count}" Width="120"/>
                        <DataGridTextColumn Header="Betrag" Binding="{Binding Amount}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Termine">
                <DataGrid x:Name="AppointmentGrid" AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Status" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Anzahl" Binding="{Binding Count}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            
            <TabItem Header="Diagramme">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <GroupBox Header="Diagnosen" Margin="0,0,0,8">
                        <lvc:CartesianChart x:Name="DiagnosisChart"/>
                    </GroupBox>

                    <GroupBox Grid.Row="1" Header="Umsatz" Margin="0,8,0,0">
                        <lvc:CartesianChart x:Name="RevenueChart"/>
                    </GroupBox>
                </Grid>
            </TabItem>
            
            <TabItem Header="Patienten ohne Karte">
                <DataGrid x:Name="PatientsWithoutCardGrid" AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Vorname" Binding="{Binding Vorname}" Width="150"/>
                        <DataGridTextColumn Header="Nachname" Binding="{Binding Nachname}" Width="150"/>
                        <DataGridTextColumn Header="Geburtsdatum" Binding="{Binding Geburtsdatum, StringFormat=dd.MM.yyyy}" Width="130"/>
                        <DataGridTextColumn Header="Telefon" Binding="{Binding Telefonnummer}" Width="150"/>
                        <DataGridTextColumn Header="E-Mail" Binding="{Binding Email}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Leistungsziffern">
                <DataGrid x:Name="ServiceCodeGrid" AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Ziffer / Leistung" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Anzahl" Binding="{Binding Count}" Width="120"/>
                        <DataGridTextColumn Header="Betrag" Binding="{Binding Amount}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Patienten-Statistik">
                <DataGrid x:Name="PatientStatsGrid" AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Versicherung" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Anzahl" Binding="{Binding Count}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

        </TabControl>

    </Grid>
</UserControl>