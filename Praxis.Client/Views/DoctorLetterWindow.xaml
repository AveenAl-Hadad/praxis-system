<Window x:Class="Praxis.Client.Views.DoctorLetterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Arztbrief"
        Width="760"
        Height="800"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <FlowDocumentScrollViewer>
            <FlowDocument x:Name="LetterDocument"
                          PagePadding="50"
                          FontFamily="Segoe UI"
                          FontSize="13"/>
        </FlowDocumentScrollViewer>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="Drucken"
                    Width="100"
                    Height="34"
                    Margin="0,0,8,0"
                    Click="Print_Click"/>

            <Button Content="Schließen"
                    Width="100"
                    Height="34"
                    Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>