<Window x:Class="Praxis.Client.Views.CreateInvoiceFromMedicalRecordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rechnung aus Karteikarte"
        Height="600"
        Width="900"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Patient:"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Margin="0,0,10,0"/>

            <ComboBox x:Name="PatientComboBox"
                      Width="360"
                      DisplayMemberPath="FullName"
                      SelectionChanged="PatientComboBox_SelectionChanged"/>
        </StackPanel>

        <DataGrid x:Name="EntriesGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="False"
                  CanUserAddRows="False"
                  SelectionMode="Extended">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Auswahl"
                                        Binding="{Binding IsSelected}"
                                        Width="80"/>

                <DataGridTextColumn Header="Datum"
                                    Binding="{Binding CreatedAt, StringFormat=dd.MM.yyyy HH:mm}"
                                    Width="150"
                                    IsReadOnly="True"/>

                <DataGridTextColumn Header="Typ"
                                    Binding="{Binding EntryType}"
                                    Width="120"
                                    IsReadOnly="True"/>

                <DataGridTextColumn Header="Titel"
                                    Binding="{Binding Title}"
                                    Width="220"
                                    IsReadOnly="True"/>

                <DataGridTextColumn Header="Leistung"
                                    Binding="{Binding CatalogItemName}"
                                    Width="*"
                                    IsReadOnly="True"/>

                <DataGridTextColumn Header="Preis"
                                    Binding="{Binding Price, StringFormat=N2}"
                                    Width="100"
                                    IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Abbrechen"
                    Width="110"
                    Margin="0,0,8,0"
                    Click="CancelButton_Click"/>

            <Button Content="Rechnung erstellen"
                    Width="160"
                    Click="CreateButton_Click"/>
        </StackPanel>
    </Grid>
</Window>