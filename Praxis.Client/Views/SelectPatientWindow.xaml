<Window x:Class="Praxis.Client.Views.SelectPatientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Patient auswählen"
        Height="520"
        Width="850"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBox x:Name="SearchTextBox"
                 Height="34"
                 FontSize="14"
                 TextChanged="SearchTextBox_TextChanged"
                 ToolTip="Name, Geburtsdatum, Telefon oder E-Mail suchen"/>

        <DataGrid x:Name="PatientsGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  MouseDoubleClick="PatientsGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nachname" Binding="{Binding Nachname}" Width="160"/>
                <DataGridTextColumn Header="Vorname" Binding="{Binding Vorname}" Width="160"/>
                <DataGridTextColumn Header="Geburtsdatum" Binding="{Binding Geburtsdatum, StringFormat=dd.MM.yyyy}" Width="120"/>
                <DataGridTextColumn Header="Telefon" Binding="{Binding Telefonnummer}" Width="150"/>
                <DataGridTextColumn Header="E-Mail" Binding="{Binding Email}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Abbrechen"
                    Width="110"
                    Margin="0,0,8,0"
                    Click="CancelButton_Click"/>

            <Button Content="Auswählen"
                    Width="120"
                    Click="SelectButton_Click"/>
        </StackPanel>
    </Grid>
</Window>